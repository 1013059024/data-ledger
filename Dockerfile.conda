# 数据台账系统 — conda-pack 构建
# 麒麟上解压 tar.gz → bash start.sh 即用（无需联网）

FROM --platform=$TARGETPLATFORM quay.io/pypa/manylinux2014_aarch64 AS builder

WORKDIR /build
COPY kylin-build/server/ ./server/

# 安装 conda
RUN curl -fsSL -o /tmp/miniforge.sh \
    https://github.com/conda-forge/miniforge/releases/download/24.11.3-0/Miniforge3-Linux-aarch64.sh \
    && bash /tmp/miniforge.sh -b -p /opt/conda \
    && rm /tmp/miniforge.sh

ENV PATH=/opt/conda/bin:$PATH

# 创建 Python 运行环境 + 安装依赖
RUN conda create -y -n py python=3.9 pip && \
    conda run -n py pip install --no-cache-dir \
        flask>=3.0 openpyxl>=3.1 xlrd>=2.0 && \
    conda install -y -n py conda-pack && \
    conda run -n py conda-pack -p /opt/conda/envs/py -o /tmp/py.tar.gz

# 打包产物
RUN mkdir -p /dist/app && \
    cp -r server/ /dist/app/ && \
    cp /tmp/py.tar.gz /dist/app/

# 创建启动脚本（设置编码避免中文乱码）
RUN printf '#!/bin/bash\nDIR="$(cd "$(dirname "$0")" && pwd)"\nexport LANG=zh_CN.UTF-8\ntar xzf "$DIR/py.tar.gz" -C "$DIR" 2>/dev/null || true\n"$DIR/py/bin/python" "$DIR/app/app.py"\n' > /dist/app/start.sh && \
    chmod +x /dist/app/start.sh

FROM scratch AS export
COPY --from=builder /dist/app/ /
