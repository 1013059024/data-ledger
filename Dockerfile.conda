# 数据台账系统 — conda-pack 构建
# 麒麟上解压 tar.gz → bash start.sh 即用（无需联网）

FROM --platform=$TARGETPLATFORM quay.io/pypa/manylinux2014_aarch64 AS builder

WORKDIR /build
COPY kylin-build/server/ ./server/

# 安装 conda
RUN curl -fsSL -o /tmp/miniforge.sh \
    https://github.com/conda-forge/miniforge/releases/download/24.11.3-0/Miniforge3-Linux-aarch64.sh \
    && bash /tmp/miniforge.sh -b -p /opt/conda \
    && rm /tmp/miniforge.sh

ENV PATH=/opt/conda/bin:$PATH

# 创建 Python 运行环境 + 安装依赖（全部用 conda 安装，更稳定）
RUN conda create -y -n py python=3.9 && \
    conda install -y -n py -c conda-forge \
        flask \
        openpyxl \
        "xlrd>=1.2,<2.0" \
        conda-pack

# 打包环境
RUN conda run -n py conda-pack -p /opt/conda/envs/py -o /tmp/py.tar.gz

# 打包产物
RUN mkdir -p /dist/app && \
    cp -r server/ /dist/app/ && \
    cp /tmp/py.tar.gz /dist/app/

# 创建启动脚本
RUN printf '#!/bin/bash\nDIR="$(cd "$(dirname "$0")" && pwd)"\nexport LANG=zh_CN.UTF-8\nif [ ! -f "$DIR/bin/python" ]; then\n  echo "首次运行，解压运行环境..."\n  tar xzf "$DIR/py.tar.gz" -C "$DIR" 2>/dev/null || true\nfi\n"$DIR/bin/python" "$DIR/server/app.py"\n' > /dist/app/start.sh && \
    chmod +x /dist/app/start.sh

FROM scratch AS export
COPY --from=builder /dist/app/ /
